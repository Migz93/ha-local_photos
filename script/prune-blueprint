#!/bin/bash

# script/prune-blueprint: Remove leftovers that only make sense in the blueprint itself
#
# Lists, or with --apply deletes, the blueprint-only files and sections that initialize.sh
# removes and that template sync can bring back or never removed, and adds the
# .templatesyncignore entries that stop the sync from bringing them back or from overwriting
# the files a project owns. Safe to run repeatedly.
# Refuses to run while initialize.sh exists, because that is the blueprint or a copy that
# has not been initialised yet.
#
# Usage:
#   ./script/prune-blueprint [--apply]
#
# Examples:
#   ./script/prune-blueprint           # Show what would be removed
#   ./script/prune-blueprint --apply   # Remove it

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

PRUNE_PATHS=(
    "docs/blueprint"
    ".agents/skills/blueprint-skill-maintenance"
    "script/tests/test_initialize.py"
)
PROJECT_OWNED_PATHS=(
    ".github/FUNDING.yml"
    ".devcontainer/project-feature"
)
SECTION_FILE=".agents/skills/README.md"
SECTION_START="<!-- blueprint-only:start -->"
SECTION_END="<!-- blueprint-only:end -->"
SYNC_IGNORE=".templatesyncignore"

APPLY=false
ALLOW_UNINITIALIZED=false
for arg in "$@"; do
    case "$arg" in
    --apply) APPLY=true ;;
    --allow-uninitialized) ALLOW_UNINITIALIZED=true ;; # initialize.sh only
    *)
        log_error "Unknown argument: $arg"
        exit 2
        ;;
    esac
done

if [[ -e initialize.sh && $ALLOW_UNINITIALIZED == false ]]; then
    log_error "initialize.sh exists: this is the blueprint or a copy that is not initialised yet. Nothing was changed."
    exit 1
fi

# Reject malformed sections before deleting any paths.
if [[ -f $SECTION_FILE ]]; then
    python3 - "$SECTION_FILE" "$SECTION_START" "$SECTION_END" <<'CHECK_SECTION'
from pathlib import Path
import sys
text = Path(sys.argv[1]).read_text()
start, end = sys.argv[2:]
if text.count(start) != text.count(end) or text.count(start) > 1 or (start in text and text.index(start) > text.index(end)):
    sys.exit("Malformed blueprint-only section; nothing was changed")
CHECK_SECTION
fi

found=0

for path in "${PRUNE_PATHS[@]}"; do
    if [[ -e $path ]]; then
        found=$((found + 1))
        if $APPLY; then
            rm -rf -- "$path"
            log_success "Removed $path"
        else
            log_info "Would remove $path"
        fi
    fi
done

if [[ -f $SECTION_FILE ]] && grep -qF "$SECTION_START" "$SECTION_FILE"; then
    found=$((found + 1))
    if $APPLY; then
        python3 - "$SECTION_FILE" "$SECTION_START" "$SECTION_END" <<'REMOVE_SECTION'
from pathlib import Path
import sys
path = Path(sys.argv[1])
text = path.read_text()
start, end = sys.argv[2:]
begin = text.index(start)
finish = text.index(end, begin) + len(end)
path.write_text(text[:begin] + text[finish:].removeprefix("\n"))
REMOVE_SECTION
        log_success "Removed blueprint-only sections from $SECTION_FILE"
    else
        log_info "Would remove blueprint-only sections from $SECTION_FILE"
    fi
fi

if [[ -f $SYNC_IGNORE ]]; then
    missing=()
    for path in "${PRUNE_PATHS[@]}" "${PROJECT_OWNED_PATHS[@]}"; do
        if ! grep -qxF -e "$path" -e "$path/" "$SYNC_IGNORE"; then
            missing+=("$path")
            $APPLY || log_info "Would add $path to $SYNC_IGNORE"
        fi
    done
    found=$((found + ${#missing[@]}))
    if $APPLY && ((${#missing[@]})); then
        printf '\n# ── Added by script/prune-blueprint ──────────────────────────\n' >>"$SYNC_IGNORE"
        printf '%s\n' "${missing[@]}" >>"$SYNC_IGNORE"
        log_success "Added ${missing[*]} to $SYNC_IGNORE"
    fi
fi

if ((found == 0)); then
    log_success "Nothing to prune"
elif ! $APPLY && ! $ALLOW_UNINITIALIZED; then
    log_info "Run ./script/prune-blueprint --apply to remove it"
fi
